# Replit provisions DATABASE_URL automatically for the built-in PostgreSQL database.
# For local or external hosting, set it to a PostgreSQL connection string.
DATABASE_URL=

# Set these values in Replit Secrets (never commit real values).
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=

# Optional application configuration.
MY_DEVELOPER_EMAIL=
GOOGLE_CALLBACK_URL=
OPENROUTER_MODEL=google/gemini-2.5-flash
FRONTEND_URL=
CORS_ORIGIN=
SESSION_COOKIE_SAME_SITE=lax

# Optional read-only bridge from the Replit admin panel to the live API.
PRODUCTION_API_URL=https://from-text-to-bpmn-api.onrender.com
ADMIN_SYNC_TOKEN=
